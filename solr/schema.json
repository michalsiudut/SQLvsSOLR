{
  "add-field-type": {
    "name": "title_prefix_type",
    "class": "solr.TextField",
    "indexAnalyzer": {
      "tokenizer": {
        "class": "solr.KeywordTokenizerFactory"
      },
      "filters": [
        {
          "class": "solr.LowerCaseFilterFactory"
        },
        {
          "class": "solr.EdgeNGramFilterFactory",
          "minGramSize": 1,
          "maxGramSize": 50
        }
      ]
    },
    "queryAnalyzer": {
      "tokenizer": {
        "class": "solr.KeywordTokenizerFactory"
      },
      "filters": [
        {
          "class": "solr.LowerCaseFilterFactory"
        }
      ]
    }
  },
  "add-field": [
    {
      "name": "title",
      "type": "text_general",
      "indexed": true,
      "stored": true,
      "multiValued": false
    },
    {
      "name": "text",
      "type": "text_general",
      "indexed": true,
      "stored": true,
      "multiValued": false
    },
    {
      "name": "topic",
      "type": "string",
      "indexed": true,
      "stored": true,
      "docValues": true,
      "multiValued": false
    },
    {
      "name": "article_type",
      "type": "string",
      "indexed": true,
      "stored": true,
      "docValues": true,
      "multiValued": false
    },
    {
      "name": "date_modified",
      "type": "pdate",
      "indexed": true,
      "stored": true,
      "docValues": true,
      "multiValued": false
    },
    {
      "name": "title_prefix",
      "type": "title_prefix_type",
      "indexed": true,
      "stored": false,
      "multiValued": false
    }
  ],
  "add-copy-field": {
    "source": "title",
    "dest": "title_prefix"
  }
}
